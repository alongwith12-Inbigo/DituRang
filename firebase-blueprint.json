{
  "entities": {
    "tutor": {
      "title": "Tutor",
      "description": "Information about a digital tutor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "boolean" },
        "workSchedule": {
          "type": "object",
          "description": "Map of dayIndex (0-4 for Mon-Fri) to array of active periods (1-7)"
        }
      },
      "required": ["id", "name", "isActive"]
    },
    "reservation": {
      "title": "Reservation",
      "description": "A tutor reservation record",
      "type": "object",
      "properties": {
        "tutorId": { "type": "string" },
        "date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
        "period": { "type": "number", "description": "1-7" },
        "reason": { "type": "string" },
        "type": { "type": "string", "enum": ["priority", "normal"] },
        "teacherName": { "type": "string" },
        "recurrenceId": { "type": "string", "description": "Optional ID to group recurring reservations" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tutorId", "date", "period", "reason", "type", "teacherName"]
    },
    "school_event": {
      "title": "School Event",
      "description": "Academic calendar event",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "title"]
    },
    "closed_month": {
      "title": "Closed Month",
      "description": "Indicates whether a month is closed for editing/updates",
      "type": "object",
      "properties": {
        "closed": { "type": "boolean" },
        "closedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["closed"]
    },
    "privacy_file": {
      "title": "Privacy File",
      "description": "Uploaded personal information files or consent forms",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string" },
        "fileContent": { "type": "string" }
      },
      "required": ["name", "fileSize", "fileType", "fileContent"]
    }
  },
  "firestore": {
    "tutors": {
      "schema": "tutor",
      "description": "Collection of tutors and their base schedules"
    },
    "reservations": {
      "schema": "reservation",
      "description": "Collection of all reservations"
    },
    "school_events": {
      "schema": "school_event",
      "description": "Collection of academic calendar events"
    },
    "closed_months": {
      "schema": "closed_month",
      "description": "Collection of closed months"
    },
    "privacy_files": {
      "schema": "privacy_file",
      "description": "Collection of uploaded personal information records"
    }
  }
}
